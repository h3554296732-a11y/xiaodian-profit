{
  "name": "xiaodian-profit",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/domain.test.ts src/lib/cloud-repository.test.ts src/lib/inventory.test.ts src/lib/password-recovery.test.ts src/lib/phone-auth.test.ts src/lib/session-recovery.test.ts src/lib/wechat-receipts.test.ts src/lib/normalize-wechat-xlsx.test.ts src/lib/import-wechat-sales.test.ts",
    "test:auth-sms": "node --experimental-strip-types --test scripts/test-auth-sms.mjs",
    "test:auth-sms-db": "node scripts/test-auth-sms-db.mjs",
    "test:db": "node scripts/db-security.mjs",
    "test:cloud-public": "node --env-file=.env.local scripts/cloud-public-check.mjs",
    "format": "prettier --write src package.json tsconfig.json postcss.config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "fflate": "0.8.3",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
